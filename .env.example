# Grass Pass environment variables. Copy to .env.local and fill in. Every key is SERVER-ONLY
# (never prefix with NEXT_PUBLIC_). On Vercel, mark every key/token as "Sensitive".

# --- Model (open weights, OpenAI-compatible chat completions) ---------------------------------
# DigitalOcean serverless inference key. Key rule (enforced in src/lib/model.ts): this key is ONLY
# ever sent to https://inference.do-ai.run. DigitalOcean keys can be full account tokens, so keep
# it server-only, mark it "sensitive" on Vercel, and never log it.
DO_INFERENCE_API_KEY=
# Default https://inference.do-ai.run/v1. Any OpenAI-compatible server works, e.g. local Ollama:
# MODEL_BASE_URL=http://localhost:11434/v1 . Plain http is refused except localhost / 127.0.0.1.
MODEL_BASE_URL=
# Default gemma-4-31B-it (Apache-2.0). The page always names the model that actually answered.
MODEL_ID=
# Key for any MODEL_BASE_URL other than DigitalOcean (required for a hosted provider; empty is fine for localhost).
MODEL_API_KEY=
# Optional, self-hosting only. Sent as `reasoning_effort` (none | low | medium | high); unset sends nothing.
# Ollama turns Gemma 4 "thinking" ON by default; set none for the measured self-host setup (README "Run it yourself").
MODEL_REASONING_EFFORT=
# Optional. Model call timeout in ms, default 30000 (~3x the slowest measured Gemma answer).
# Clamped to 5000-70000. Raise it (e.g. 60000) for the slower Llama 4 Maverick fallback.
MODEL_TIMEOUT_MS=

# --- Lucky Finds (optional) -----------------------------------------------------------------------
# SerpApi key (https://serpapi.com, free plan: 250 searches/month; check usage free at serpapi.com/account.json).
# Server only: it is sent only to https://serpapi.com/search.json and never logged. Lucky Finds count Google
# Maps reviews that mention dogs, bikes, ducks or skateboards (review text is never shown or sent to the AI).
# Without it the Lucky Finds section says "not connected". Caps: SERPAPI_DAILY_CAP / SERPAPI_MONTHLY_CAP below.
SERPAPI_API_KEY=
# Find This Spot photos (P1, optional; not used this week).
MAPILLARY_TOKEN=

# --- Shared store for caches, rate limits and caps (required in production) -----------------------
# Upstash Redis REST URL (https://<name>.upstash.io) and token. Without them everything is in memory
# (fine for local dev; on Vercel each instance would then have its own limits).
# KV_REST_API_URL / KV_REST_API_TOKEN are accepted too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Monthly Upstash command budget (free plan: 500000). Commands are counted in batches of 10; the logs get
# "upstash_budget" at 50% (warn), 80% and 90% (error) of this number. At 90% Grass Pass "rests" until the
# 1st of next month (UTC): saved and example passes still open, new passes and park searches answer 503.
# Each Chicago day may use 90% of this / days in the month; past that, new passes and new park searches
# are paused until midnight ("upstash_daily_pace" in the logs).
UPSTASH_MONTHLY_COMMANDS=500000
# Secret key for hashing client IPs into rate-limit keys (HMAC-SHA256; the store and logs never hold a raw IP).
# At least 16 characters, e.g. `openssl rand -base64 32`. If unset: derived from the Upstash token (stable across
# instances; changing the token resets per-IP counters); without Upstash: random per process.
LIMITER_KEY_SECRET=

# --- Caps and limits (defaults shown) -------------------------------------------------------------
# Model calls per day (America/Chicago), all users together. A pass makes 1-3 calls and each one counts.
# At 400 calls: about $0.28/day typical, at most about $0.55/day. A call may be sent twice on a network error or 5xx
# (usually unbilled). The $10 prepaid DigitalOcean credit is the hard ceiling. 0 switches new model passes off
# (the emergency stop; an empty DO_INFERENCE_API_KEY also stops every call).
AI_DAILY_CAP=400
# Percent of AI_DAILY_CAP kept for the example parks and the server warm-up (0-50, default 10), so a flood of
# other new passes can't use the whole day. The logs get "quota_alert" at 50% and 90% of every global cap.
AI_RESERVE_PCT=10
# In-process pre-limiter in front of every page and API route that reads the store (per IP, per instance;
# an IPv6 /48 gets one shared bucket of 2x these). Over any bucket: 429 without any Upstash command.
# API requests: a burst, then a refill per second.
PRELIMIT_BURST=40
PRELIMIT_PER_SEC=4
# Page requests (/ and /pass/*): a burst, then a refill per minute (120 = 2 a second). A flood guard only.
PRELIMIT_PAGE_BURST=120
PRELIMIT_PAGE_PER_MIN=120
# Store-cost units (at least the Upstash commands of a request's cheap path: a saved-pass page 1, an API
# call 4): a burst, then a refill per hour. 45/h keeps one IPv4 address under 32% of the free 500K commands
# a month, new passes and park searches included (math: src/lib/limits/prelimit.ts).
PRELIMIT_COST_BURST=60
PRELIMIT_COST_PER_HOUR=45
# SerpApi searches per day (America/Chicago) and per month, all users together, checked BEFORE each search; a sent
# search counts even if it fails. The monthly cap is clamped to 250 (the free plan). A new park uses up to 4
# searches; each park's counts are kept 30 days. When a cap is hit the pass says "free search limit reached".
# 0 switches searches off (no request is sent).
SERPAPI_DAILY_CAP=12
# The monthly cap counts from this day of the month (1-28, Chicago midnight): set it to your SerpApi plan's renewal
# day (plan_renewal_date on serpapi.com/account.json; the project's free plan renews on the 16th). Default 1.
SERPAPI_RENEWS_DAY=1
SERPAPI_MONTHLY_CAP=200
# Per-IP limits for new passes (IPv6 by /64; one /48 may use at most 2x the daily share).
PASS_PER_IP_PER_MIN=3
PASS_PER_IP_PER_DAY=20
# Per-IP limit for park searches per minute.
PARKS_PER_IP_PER_MIN=10
# Uncached park searches (Nominatim + Overpass): per IP per day, and all users per day.
PARKS_PER_IP_PER_DAY=60
PARKS_DAILY_CAP=2000

# --- Data sources ---------------------------------------------------------------------------------
# Overpass API endpoints, tried in order (comma list, https only, up to 4). One query waits at most 50 s
# across all of them (a park search only 10 s, then it uses the saved Dallas-area park list or Nominatim). maps.mail.ru was verified live 2026-10-05; private.coffee hung 30-40 s that day, so it is last.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter
# iNaturalist API calls per day, all users together (iNat asks for < 10,000/day; default 3000).
INAT_DAILY_CAP=3000
# Public repo URL, sent in the User-Agent to OpenStreetMap / iNaturalist (their usage policies ask for it).
# Must be a plain https URL; anything else (or an email) falls back to https://github.com/c0de128/grass-pass.
APP_CONTACT_URL=
# Example parks on the home page (list in src/lib/prewarm.ts): passes are made at start-up and kept warm
# (one background refresh per park per day, global caps only). Set to 0 to switch off (the page then says so).
PREWARM_EXAMPLES=1
# Saved OpenStreetMap answers (src/data/osm, recorded by `pnpm osm:snapshot`) are refreshed live in the
# background, at most once per park every 6 hours, at low priority. Set to 0 to switch the refresh off.
OSM_BACKGROUND_REFRESH=1

# --- Accounts (sign-in is only needed to make a NEW pass and to send item reports) -------------------
# Required for sign-in: 32+ random bytes, e.g. `npx auth secret` or `openssl rand -base64 33`. Encrypts the session
# cookie and keys the scrambled account IDs (HMAC). Changing it signs everyone out and resets the account counts.
AUTH_SECRET=
# GitHub OAuth app (callback http://localhost:3123/api/auth/callback/github locally,
# https://<production-domain>/api/auth/callback/github in production). Both empty = no GitHub button.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth client, Web application (redirect URIs .../api/auth/callback/google). Both empty = no Google button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: the public origin, only when it differs from the Host the server sees (e.g. a custom domain behind a proxy).
AUTH_URL=
# "Try as a judge": one-click shared demo account (on unless 0), and its new passes per day for ALL judges together
# (default 60; at most 3 of them from one connection). JUDGE_DEMO_DAILY_CAP=0 means no new judge passes
# (the button still signs in); JUDGE_DEMO=0 hides the button.
JUDGE_DEMO=1
JUDGE_DEMO_DAILY_CAP=60

# --- Site ---------------------------------------------------------------------------------------
# Public origin used for absolute share-image URLs (Open Graph) and the pass address printed on the stub
# ("Made with Grass Pass: <host>/pass/<id>"). On Vercel the production domain (VERCEL_PROJECT_PRODUCTION_URL) is
# used automatically; locally it falls back to http://localhost:3000.
SITE_URL=

# --- Evals (dev only, see evals/README.md; never set on Vercel) -----------------------------------
# pnpm eval stops starting new model calls once measured spend reaches this many US dollars.
EVAL_BUDGET_USD=1
# Optional: comma lists to run a subset (the result is then marked PARTIAL).
EVAL_MODELS=
EVAL_CASES=
EVAL_RUNS=

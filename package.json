{
  "name": "grass-pass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:limits": "playwright test -c playwright.limits.config.ts",
    "eval": "vitest run --config evals/vitest.config.mts evals/cli/eval.ts",
    "eval:record": "vitest run --config evals/vitest.config.mts evals/cli/record.ts",
    "eval:report": "vitest run --config evals/vitest.config.mts evals/cli/report.ts",
    "eval:check": "vitest run --config evals/vitest.config.mts evals/cli/check.ts",
    "eval:replay": "vitest run --config evals/vitest.config.mts evals/cli/replay.ts",
    "osm:snapshot": "vitest run --config evals/vitest.config.mts evals/cli/osm-snapshot.ts"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@fontsource/varela-round": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "opentype.js": "^2.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  }
}
